{
  "name": "@youasked/mcp",
  "version": "0.1.0",
  "description": "MCP server for YouAsked: let your coding agent read feature requests, reply, and ship them.",
  "license": "MIT",
  "type": "module",
  "bin": { "youasked-mcp": "./dist/index.js" },
  "main": "./dist/index.js",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
