{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "youasked-api",
  "main": "src/index.ts",
  // Keep the old *.workers.dev address working for installs that already point at it.
  "workers_dev": true,
  "routes": [{ "pattern": "api.youasked.dev", "custom_domain": true }],
  // "off" until Cloudflare Email Sending is enabled for youasked.dev; then remove it.
  "vars": { "EMAIL_SIGN_IN": "off" },
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Weekly digest to connected Telegram chats: Mondays 01:00 UTC (09:00 Singapore).
  // Daily Heard elsewhere scan: 02:30 UTC (10:30 Singapore). Keep in step with DAILY_CRON in src/index.ts.
  "triggers": { "crons": ["0 1 * * 1", "30 2 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "youasked",
      "database_id": "b16d8e4a-66d5-4df2-a48a-d743d63e1dea",
      "migrations_dir": "migrations"
    }
  ],
  // Screenshots attached to requests. Create the bucket once with `wrangler r2 bucket create youasked-uploads`;
  // `wrangler dev` simulates it locally without that.
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "youasked-uploads" }],
  // Duplicate catching by meaning. Create the index once (384 dims, cosine) with:
  //   wrangler vectorize create youasked-requests --dimensions=384 --metric=cosine
  // Both bindings are optional in code; without them the API falls back to word matching.
  // Workers AI: embeddings for duplicates, Heard elsewhere triage, build prompts and digest summaries.
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "youasked-requests" }],
  // Cloudflare Email Sending (sign-in links, invites). hello@youasked.dev must be onboarded under
  // Compute > Email Service once the domain is on Cloudflare. Without the binding, mail is logged.
  "send_email": [{ "name": "EMAIL" }]
}
