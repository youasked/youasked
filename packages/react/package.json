{
  "name": "@youasked/react",
  "version": "0.7.3",
  "description": "Feature requests your users can vote on, and a 'you asked, it's live' moment when you ship.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "playground": "esbuild playground/main.tsx --bundle --splitting --format=esm --jsx=automatic --entry-names=bundle --outdir=playground/out",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "modern-screenshot": "^4.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "author": "Aden Teo",
  "homepage": "https://youasked.adenteo.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youasked/youasked.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/youasked/youasked/issues"
  },
  "keywords": [
    "react",
    "nextjs",
    "feature-requests",
    "feedback",
    "widget",
    "roadmap",
    "changelog"
  ],
  "publishConfig": {
    "access": "public"
  }
}
